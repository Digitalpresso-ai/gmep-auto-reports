{
  "name": "gmep-auto-reports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain",
    "test:db": "vitest run tests/db",
    "db:migrate": "node db/migrate.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:api": "vitest run tests/api",
    "admin:password": "node scripts/set-admin-password.ts",
    "shared:clear": "node scripts/clear-shared-days.ts",
    "db:local": "docker start gmep-local-db 2>/dev/null || docker run -d --name gmep-local-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=gmep -p 127.0.0.1:54329:5432 -v gmep-local-db:/var/lib/postgresql/data postgres:16",
    "dev:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:54329/gmep next dev",
    "db:migrate:local": "MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/gmep node db/migrate.ts",
    "admin:password:local": "MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/gmep node scripts/set-admin-password.ts",
    "db:reset": "node scripts/reset-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.1",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.15.1",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "next": "16.4.4",
    "pdfjs-dist": "^6.5.438",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
