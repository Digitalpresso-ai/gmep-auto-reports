# 로컬은 이 파일을 .env.local로 복사해 채운다. Vercel은 Project Settings → Environment Variables에 같은 이름으로 넣는다.
# 모든 값은 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이지 않는다.

# Supabase → Connect → Transaction pooler (포트 6543). Vercel 함수가 사용한다.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase → Connect → Session pooler (포트 5432). npm run db:migrate 에만 사용한다.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API. 사진 Storage 접근에만 사용한다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PHOTO_BUCKET=report-storages

# Anthropic Console에서 이 서비스 전용 워크스페이스로 발급한 키
ANTHROPIC_API_KEY=
